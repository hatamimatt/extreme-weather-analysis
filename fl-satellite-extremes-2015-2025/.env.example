# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# NASA Earthdata Login (IMERG, MERRA-2, NLDAS-2 via GES DISC Cloud OPeNDAP).
# Alternatively put them in ~/.netrc:  machine urs.earthdata.nasa.gov login <user> password <pass>
EARTHDATA_USER=
EARTHDATA_PASS=
# DestinE Earth Data Hub token (ERA5 2022-2025 zarr), used by prod/edh_dl.py and prod/edh_chunks*.py
DESTINE_EDH_TOKEN=
# Copernicus CDS (ERA5 2015-2021): put your key in ~/.cdsapirc
#   url: https://cds.climate.copernicus.eu/api
#   key: <your-personal-access-token>
